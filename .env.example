# --- LLM Provider API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# --- LangSmith Observability & Tracing (Week 8 & Capstone) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-ai-course

# --- Vector Database Configuration (Weeks 2, 3, 7) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# --- Safety & Evaluation (Week 8) ---
DEEPEVAL_API_KEY=
GUARDRAILS_API_KEY=

# --- Protocol & Server Ports (Week 6) ---
MCP_SERVER_PORT=8000
A2A_BROKER_URL=http://localhost:8080

# --- General Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development
